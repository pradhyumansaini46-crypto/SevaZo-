# ==============================================================================
# SEVAZO UNIFIED MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=production

# Backend API Configuration
PORT=4000
API_PREFIX=api/v1
APP_NAME=Sevazo-Admin-API

# Database (PostgreSQL)
DATABASE_URL="postgresql://sevazo:sevazopassword@localhost:5432/sevazo_db?schema=public"
POSTGRES_USER=sevazo
POSTGRES_PASSWORD=sevazopassword
POSTGRES_DB=sevazo_db
POSTGRES_PORT=5432

# Redis Cache & BullMQ Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Token Rotation
JWT_SECRET=sevazo-super-secret-jwt-access-key-replace-in-production-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=sevazo-super-secret-jwt-refresh-key-replace-in-production-2026
JWT_REFRESH_EXPIRES_IN=7d

# Default Super Admin Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@sevazo.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_NAME="Super Administrator"

# Next.js Admin Portal
NEXT_PUBLIC_API_URL=https://seva-zo-admin-six.vercel.app/
NEXT_PUBLIC_APP_NAME=Sevazo
NEXT_PUBLIC_APP_URL=https://seva-zo-admin-six.vercel.app/

# CORS Allowed Origins
CORS_ORIGINS=https://seva-zo-admin-six.vercel.app/
