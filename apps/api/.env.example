# ==============================================================================
# SEVAZO API ENVIRONMENT VARIABLES (Vercel Project: sevazo-api)
# ==============================================================================

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

# PostgreSQL Database Connection (Supabase / Neon / AWS RDS / Vercel Postgres)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public&sslmode=require"

# Redis Cache & Queues (Upstash / AWS ElastiCache / Redis Cloud)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=your-production-jwt-access-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-production-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Web Origins (Frontend Apps & Admin)
CORS_ORIGINS=https://seva-zo-admin-six.vercel.app,http://localhost:3000
