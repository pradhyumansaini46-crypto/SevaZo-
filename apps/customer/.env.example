# ==========================================
# TURSO DATABASE CONFIGURATION FOR SEVAZO
# ==========================================
# Add these variables to your Vercel Project:
# Go to: Vercel Dashboard -> Your Project -> Settings -> Environment Variables

# 1. Turso Database URL (Both keys recommended for full client & serverless compatibility)
EXPO_PUBLIC_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# 2. Turso Auth Token
EXPO_PUBLIC_TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_AUTH_TOKEN=your-turso-auth-token

# 3. Optional Backend API URL (falls back to localhost or mock if not set)
EXPO_PUBLIC_API_URL=https://api.sevazo.com/api/v1
